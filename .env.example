API_PORT=8080
SENDER_PORT=8081
RECIPIENT_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

APP_ROLE=sender
APP_EMAIL=sender@example.com
DOCUMENT_STORAGE_PATH=data/storage
APP_PRIVATE_KEY_PATH=data/keys/private.pem
APP_PUBLIC_KEY_PATH=data/keys/public.pem
# Alternative to *_PATH:
# APP_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# APP_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com
# SMTP_USER=
# SMTP_PASSWORD=

MAIL_POLL_ENABLED=true
MAIL_POLL_INTERVAL=5s
MAIL_SOURCE_TYPE=mailpit
MAIL_SOURCE_BASE_URL=http://localhost:8025
MAIL_SOURCE_LIMIT=25
MAIL_FILTER_RECIPIENT_EMAIL=recipient@example.com
MAIL_FILTER_SUBJECT_PREFIX=Encrypted document package:
MAIL_FILTER_ATTACHMENT_SUFFIX=_encrypted_package.json

SENDER_APP_EMAIL=sender@example.com
RECIPIENT_APP_EMAIL=recipient@example.com

MAILPIT_CONTAINER_NAME=eds_lab_mailpit
SENDER_CONTAINER_NAME=eds_lab_sender
RECIPIENT_CONTAINER_NAME=eds_lab_recipient
MAILPIT_UI_PORT=8025
